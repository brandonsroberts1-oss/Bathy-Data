{
  "name": "bathy-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fetch real bathymetric data for U.S. waterways and bodies of water and export layered SVG contour maps for laser cutting (xTool Studio, Glowforge, etc.).",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "d3-contour": "^4.0.2",
    "d3-geo": "^3.1.1",
    "express": "^4.19.2",
    "geotiff": "^2.1.3",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "vite": "^5.4.2"
  },
  "engines": {
    "node": ">=18"
  }
}
